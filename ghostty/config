# Ghostty configuration — https://ghostty.org/docs/config
# Symlinked to ~/.config/ghostty/config by install.sh.
# Reload after editing: cmd+shift+,   Everything Ghostty can do: cmd+shift+p
#
# Only what differs from Ghostty's defaults is set here. See every option and
# its default with:  ghostty +show-config --default --docs

# --- Look ---
# JetBrainsMono Nerd Font comes from the Brewfile; Starship needs its glyphs.
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# Same colour scheme as Neovim (LazyVim's default is tokyonight "moon"), so the
# editor and the shell around it look like one thing. Preview the bundled
# themes with `ghostty +list-themes`.
theme = TokyoNight Moon

window-padding-x = 8
window-padding-y = 8
# Spread leftover pixels evenly so the grid stays centred in the window.
window-padding-balance = true
mouse-hide-while-typing = true

# --- Windows, tabs, splits ---
# Reopen the same windows, tabs and splits (and their directories) on launch.
window-save-state = always
# Close a tab or split without asking, even with something running in it.
confirm-close-surface = false

# --- Clipboard ---
# Selecting text copies it, as on Linux. cmd+c / cmd+v work as usual.
copy-on-select = clipboard

# --- Shell integration ---
# Defaults (cursor, title, path) plus:
#   sudo         — keep xterm-ghostty terminfo across `sudo`, so `sudo nvim` works
#   ssh-env      — send COLORTERM and downgrade TERM to xterm-256color over ssh
#   ssh-terminfo — install Ghostty's terminfo on remote hosts (once, then cached),
#                  which fixes "unknown terminal type xterm-ghostty" on servers
shell-integration-features = cursor,title,path,sudo,ssh-env,ssh-terminfo

# --- Long-running commands ---
# A command that ran longer than 10s sends a macOS notification when it ends,
# but only if you were looking at another tab, split or app at that moment.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# --- Keyboard ---
# LEFT Option is Alt, so the shell's Alt keys work (alt+b / alt+f / alt+d,
# alt+backspace, alt+.). Right Option still types special characters.
macos-option-as-alt = left

# Drop-down terminal from any app (macOS asks for Accessibility permission
# the first time).
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.1

# Name a tab, so ten of them stay tellable apart.
keybind = cmd+shift+r=prompt_tab_title
# Open this terminal's whole scrollback as a text file, to search or copy from.
keybind = cmd+shift+s=write_scrollback_file:open

# Ghostty defaults worth knowing (nothing to set — just don't unbind them):
#   cmd+t / cmd+w            new tab / close           cmd+1..8  go to tab
#   cmd+d / cmd+shift+d      split right / down
#   cmd+alt+arrows           move between splits       cmd+[ / cmd+]  prev / next
#   cmd+ctrl+arrows          resize split              cmd+ctrl+=     equalize
#   cmd+shift+enter          zoom the current split to the full tab, and back
#   cmd+up / cmd+down        jump to the previous / next prompt
#   cmd+f                    search scrollback         cmd+g  next match
#   cmd+k                    clear screen              cmd+z  undo close
#   cmd+left / cmd+right     start / end of line       (sent as ctrl+a / ctrl+e)
#   opt+left / opt+right     word back / forward       (sent as alt+b / alt+f)
#   cmd+backspace            delete to start of line   (sent as ctrl+u)
# Line editing itself is the shell's job: zsh/zshrc and bash/inputrc.

# --- Sessions ---
# Nothing starts automatically. For a shell that survives closing the tab,
# run `zmx attach <name>` (detach: ctrl+\).

# --- Updates ---
# Installed by Homebrew, so brew upgrades it; Ghostty only says one is out.
auto-update = check

# ============================================================================
# Optional — uncomment to taste
# ============================================================================
# Follow the macOS light / dark appearance (Neovim stays dark, though).
# theme = dark:TokyoNight Moon,light:TokyoNight Day

# Translucent background with a blur behind it.
# background-opacity = 0.95
# background-blur = true

# How much the unfocused side of a split is dimmed (default 0.7; 1 = not at all).
# unfocused-split-opacity = 0.85

# Turn off JetBrains Mono's programming ligatures (-> stays two glyphs).
# font-feature = -calt,-liga,-dlig

# Thicker glyphs; helps on a non-Retina external display.
# font-thicken = true
