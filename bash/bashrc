# .bashrc — bash on Linux servers and the odd `bash` session on macOS.
# zsh is the main shell (zsh/zshrc); this is the short version of it.

case $- in *i*) ;; *) return ;; esac    # interactive shells only

[ -f /etc/bashrc ] && . /etc/bashrc

# ============================================================================
# ENVIRONMENT
# ============================================================================

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$HOME/bin:$PATH" ;;
esac
export PATH

if command -v nvim &> /dev/null; then
    export EDITOR=nvim VISUAL=nvim
else
    export EDITOR=vim VISUAL=vim
fi

export CLICOLOR=1
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

# ============================================================================
# HISTORY + OPTIONS
# ============================================================================

HISTSIZE=20000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups   # no duplicates, skip lines starting with a space
HISTTIMEFORMAT='%F %T '
shopt -s histappend checkwinsize cdspell
shopt -s dirspell 2> /dev/null     # bash 4+; macOS ships 3.2

[ -f /etc/bash_completion ] && . /etc/bash_completion

# ============================================================================
# ALIASES + FUNCTIONS (same names as zsh/zshrc)
# ============================================================================

if [ "$(uname -s)" = "Darwin" ]; then
    alias ls='ls -G'
else
    alias ls='ls --color=auto'
fi
alias ll='ls -lh'
alias la='ls -lhA'
alias grep='grep --color=auto'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -pv'

alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'

mkcd() { mkdir -p "$1" && cd "$1"; }

# ============================================================================
# KUBERNETES
# ============================================================================

alias k='kubectl'
alias kgp='kubectl get pods'
alias kl='kubectl logs'
alias kex='kubectl exec -it'
if command -v kubectl &> /dev/null; then
    source <(kubectl completion bash)
    complete -o default -F __start_kubectl k
fi

# ============================================================================
# PROMPT
# ============================================================================

if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
fi

# ============================================================================
# LOCAL OVERRIDES
# ============================================================================
# Machine-specific snippets live in ~/.bashrc.d/ (not tracked by this repo)
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        [ -f "$rc" ] && . "$rc"
    done
    unset rc
fi
