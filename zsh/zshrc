# .zshrc — interactive zsh configuration (ported from the bash config)
# Works on macOS (default) and Linux.

# ============================================================================
# ENVIRONMENT
# ============================================================================

export EDITOR=nvim
export VISUAL=nvim

# Colors (BSD ls on macOS, GNU ls on Linux)
export CLICOLOR=1
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

OS_TYPE="$(uname -s)"

# ============================================================================
# HISTORY
# ============================================================================

HISTFILE="$HOME/.zsh_history"
HISTSIZE=20000
SAVEHIST=20000
setopt EXTENDED_HISTORY        # timestamps in history
setopt SHARE_HISTORY           # share history across sessions
setopt HIST_IGNORE_ALL_DUPS    # no duplicate entries
setopt HIST_IGNORE_SPACE       # ignore commands starting with a space
setopt HIST_REDUCE_BLANKS

# ============================================================================
# SHELL OPTIONS
# ============================================================================

setopt AUTO_CD                 # `dir` instead of `cd dir`
setopt NO_CASE_GLOB            # case-insensitive globbing
setopt INTERACTIVE_COMMENTS    # allow # comments in interactive shell

# ============================================================================
# KEY BINDINGS
# ============================================================================

# Line editing behaves like bash on a stock Linux box (readline + /etc/inputrc);
# bash itself gets the same keys from bash/inputrc. Ghostty's macOS keys feed
# into these (cmd+left -> ^A, opt+left -> alt-b, ...), see ghostty/config.
# Must be explicit — with EDITOR=nvim zsh silently starts in vi mode instead.
bindkey -e

# Word = letters and digits only, as in readline: alt-b / alt-f / alt-backspace
# stop at / . - _ (zsh default treats a whole path as one word)
WORDCHARS=''

bindkey '^U' backward-kill-line         # Ctrl-U: delete to line start (zsh default: whole line)
bindkey '^[f' emacs-forward-word        # Alt-F: to the END of the word, as in bash

# Ctrl-W: delete back to the previous space (bash's unix-word-rubout)
autoload -Uz backward-kill-word-match
zle -N unix-word-rubout backward-kill-word-match
zstyle ':zle:unix-word-rubout' word-style whitespace
bindkey '^W' unix-word-rubout

# Home / End / Delete, in both normal and application cursor modes
bindkey '^[[H'  beginning-of-line
bindkey '^[OH'  beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[OF'  end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[3~' delete-char

# Ctrl-Left/Right and Alt-Left/Right: word jump (on macOS, Ctrl-arrows only
# arrive if Mission Control's "Move left/right a space" shortcuts are off)
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' emacs-forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' emacs-forward-word

# Ctrl-X Ctrl-E: edit the command line in $EDITOR, like bash
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ============================================================================
# COMPLETION
# ============================================================================

autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive

# ============================================================================
# ALIASES
# ============================================================================

# ls (platform-aware)
if [ "$OS_TYPE" = "Darwin" ]; then
    alias ls='ls -G'
    alias ll='ls -lhG'
    alias la='ls -lhAG'
else
    alias ls='ls --color=auto'
    alias ll='ls -lh --color=auto'
    alias la='ls -lhA --color=auto'
fi

# grep with color
alias grep='grep --color=auto'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Safety
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -pv'

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'

# ============================================================================
# FUNCTIONS
# ============================================================================

# Create directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract various archive types
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *)           echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Find files by name
ff() {
    find . -type f -iname "*$1*"
}

# Find directories by name
ffd() {
    find . -type d -iname "*$1*"
}

# ============================================================================
# STARSHIP PROMPT
# ============================================================================

if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# ============================================================================
# 1PASSWORD
# ============================================================================

# Use the 1Password SSH agent when its socket exists (requires the desktop app
# with "Use the SSH agent" enabled in Settings → Developer).
if [ "$OS_TYPE" = "Darwin" ]; then
    _OP_SSH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
else
    _OP_SSH_SOCK="$HOME/.1password/agent.sock"
fi
[ -S "$_OP_SSH_SOCK" ] && export SSH_AUTH_SOCK="$_OP_SSH_SOCK"
unset _OP_SSH_SOCK

# op CLI: completion + shell plugins (op plugin init <tool> writes plugins.sh)
if command -v op &> /dev/null; then
    eval "$(op completion zsh)"
    [ -f "$HOME/.config/op/plugins.sh" ] && source "$HOME/.config/op/plugins.sh"
fi

# ============================================================================
# KUBERNETES
# ============================================================================

if command -v kubectl &> /dev/null; then
    source <(kubectl completion zsh)
    compdef k=kubectl   # let the `k` alias use kubectl completion
fi

# The few worth typing; k9s covers the rest
alias k='kubectl'
alias kgp='kubectl get pods'
alias kl='kubectl logs'
alias kex='kubectl exec -it'

# ============================================================================
# LOCAL OVERRIDES
# ============================================================================
# Drop machine-specific snippets in ~/.zshrc.d/ (not tracked by this repo)
if [ -d "$HOME/.zshrc.d" ]; then
    for rc in "$HOME"/.zshrc.d/*.zsh(N); do
        [ -f "$rc" ] && source "$rc"
    done
    unset rc
fi
